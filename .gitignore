# ---------------------------------------------------------------------------
# Local-only documents (not part of the deliverable)
# ---------------------------------------------------------------------------
PHASES.md
promt.md

# ---------------------------------------------------------------------------
# Data: keep the folder structure, ignore the contents.
# scripts/download_dataset.py re-fetches the CSV on `make download` / `make all`,
# so the 14 MB raw file never needs to be committed.
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep

# Generated by `make profile` — regenerated on every run
data/profile.txt

exports/*
!exports/.gitkeep

