# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust if needed:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Host ports (change these if 5432 / 3000 are already taken) -------------
POSTGRES_PORT=5432
METABASE_PORT=3000

# --- Warehouse credentials --------------------------------------------------
DB_USER=dw
DB_PASSWORD=dw
DB_NAME=warehouse
DB_HOST=localhost
DB_PORT=5432

# --- Hugging Face dataset ---------------------------------------------------
HF_REPO_ID=Omer1234567/telco-churn-synthetic
HF_FILENAME=synthetic_customer_data_evenly_distributed.csv

# --- Metabase admin login (used by `make metabase-dashboards`) --------------
# Fill these in your local `.env` (which is gitignored) with the account you
# created in the Metabase setup wizard. Leave them empty in this example file.
MB_URL=http://localhost:3000
MB_USER=
MB_PASS=
MB_DATABASE=warehouse
MB_COLLECTION=Telco Churn DSS
